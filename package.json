{
  "name": "nest-problem-details-filter",
  "version": "1.9.0",
  "description": "RFC 9457 Problem Details for NestJS — standardized HTTP errors, typed problem exceptions, validation errors, Retry-After, and OpenAPI integration.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./swagger": {
      "types": "./dist/swagger/index.d.ts",
      "default": "./dist/swagger/index.js"
    },
    "./class-validator-mappers": {
      "types": "./dist/class-validator-mappers/index.d.ts",
      "default": "./dist/class-validator-mappers/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fcmam5/nest-problem-details.git"
  },
  "author": "Abdeldjalil Fortas (Fcmam5)",
  "bugs": {
    "url": "https://github.com/Fcmam5/nest-problem-details/issues"
  },
  "homepage": "https://github.com/Fcmam5/nest-problem-details#readme",
  "keywords": [
    "nestjs",
    "problem-details",
    "problem+json",
    "rfc9457",
    "rfc7807",
    "http-errors",
    "exception-filter",
    "openapi",
    "validation",
    "retry-after"
  ],
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/Fcmam5"
  },
  "scripts": {
    "build": "rm -f tsconfig.build.tsbuildinfo && nest build",
    "prepublishOnly": "rm -rf dist && npm run build",
    "format": "prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\"",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "start:mock": "node --watch -r ts-node/register tests/mock-main.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-fastify": "^12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-todo-tickets": "^1.4.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/swagger": "^9.0.0 || ^10.0.0 || ^11.0.0 || ^12.0.0",
    "class-validator": "^0.14.0 || ^0.15.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/swagger": {
      "optional": true
    },
    "class-validator": {
      "optional": true
    }
  }
}
